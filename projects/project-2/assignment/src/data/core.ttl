iao-edit:has_SRS rdf:type owl:DatatypeProperty ;
                 rdfs:domain iao-edit:Aircraft ;
                 rdfs:range xsd:string ;
                 rdfs:label "has SRS" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "SRS determines separation between a departing aircraft from a preceding departing or arriving aircraft using the same runway" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_TDG
iao-edit:has_TDG rdf:type owl:DatatypeProperty ;
                 rdfs:domain iao-edit:Aircraft ;
                 rdfs:range xsd:integer ;
                 rdfs:label "has TDG" ;
                 <http://www.w3.org/2004/02/skos/core#definition> """TDG is determined based on combination of Main Gear Width and Cockpit to Main Gear Distance per FAA AC 150/5300-13B.
Taxiway Design Group""" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_TMFS_Operations_FY24
iao-edit:has_TMFS_Operations_FY24 rdf:type owl:DatatypeProperty ;
                                  rdfs:domain iao-edit:Aircraft ;
                                  rdfs:range xsd:integer ;
                                  rdfs:label "has TMFS Operations FY24" ;
                                  <http://www.w3.org/2004/02/skos/core#definition> """Total NAS Operations with TFMS Flight Plan (IFR or VFR) in year indicated
Underestimation of operations for small piston aircraft that operate mostly (~55%) without flight plans""" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Tail_Height_Ft
iao-edit:has_Tail_Height_Ft rdf:type owl:DatatypeProperty ;
                            rdfs:domain iao-edit:Aircraft ;
                            rdfs:range xsd:decimal ;
                            rdfs:label "has Tail Height Ft" ;
                            <http://www.w3.org/2004/02/skos/core#definition> """Aircraft Tail Height at Operating Empty Weight (OEW)
OEW is the operating empty weight of an aircraft including the crew, all fluids necessary for operation such as engine oil but excluding fuel and no payload.""" .


