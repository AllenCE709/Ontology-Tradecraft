#################################################################
#    Data properties
#################################################################

###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_AAC
iao-edit:has_AAC rdf:type owl:DatatypeProperty ;
                 rdfs:domain iao-edit:Aircraft ;
                 rdfs:range xsd:string ;
                 rdfs:label "has AAC" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Standard abbreviations for aircraft assigned by ICAO that are most commonly used by air traffic services." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_ADG
iao-edit:has_ADG rdf:type owl:DatatypeProperty ;
                 rdfs:domain iao-edit:Aircraft ;
                 rdfs:range xsd:string ;
                 rdfs:label "has ADG" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "ADG is determined based on combination of Tail Height and Wingspan per FAA AC 150/5300-13B." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Approach_Speed_Knot
iao-edit:has_Approach_Speed_Knot rdf:type owl:DatatypeProperty ;
                                 rdfs:domain iao-edit:Aircraft ;
                                 rdfs:range xsd:integer ;
                                 rdfs:label "has Approach Speed Knot" ;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Approach speed is the highest speed in the approach phase determined by considering landing flap configurations and MALW in Flight Standardization Board (FSB) or aircraft manufacturer's documentation. For aircraft with a single reported Approach Speed, columns N and O are empty." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_CWT
iao-edit:has_CWT rdf:type owl:DatatypeProperty ;
                 rdfs:domain iao-edit:Aircraft ;
                 rdfs:range xsd:string ;
                 rdfs:label "has CWT" ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Consolidated Wake Turbulence Category; Category A (largest) to category I (smallest) based on aircraft maximum takeoff weight" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Cockpit_to_Main_Gear_Ft
