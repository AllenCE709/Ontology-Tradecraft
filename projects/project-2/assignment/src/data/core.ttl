###  http://purl.obolibrary.org/obo/IAO_0000590
obo:IAO_0000590 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000300 ;
                obo:IAO_0000111 "written name"@en ;
                obo:IAO_0000112 "\"Bill Clinton\""@en ,
                                "\"The Eiffel Tower\""@en ,
                                "\"United States of America\""@en ;
                obo:IAO_0000114 obo:IAO_0000125 ;
                obo:IAO_0000117 "PERSON: Bill Hogan"@en ;
                obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/114"@en ;
                obo:IAO_0000232 "The qualifier \"written\" is to set it apart from spoken names.  Also, note the restrictions to particulars.  We are not naming universals.   We could however, be naming, attributive collections which are particulars, so \"All people located in the boundaries of the city of Little Rock, AR on June 18, 2011 at 9:50a CDT\" would be a name."@en ;
                rdfs:label "written name"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A textual entity that denotes a particular in reality."@en .


###  http://purl.obolibrary.org/obo/IAO_0000591
obo:IAO_0000591 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000010 ;
                obo:IAO_0000114 obo:IAO_0000123 ;
                obo:IAO_0000117 "PERSON: Melanie Courtot"@en ,
                                "PERSON: Michel Dumontier"@en ;
                obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                rdfs:label "software method"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en .


###  http://purl.obolibrary.org/obo/IAO_0000592
obo:IAO_0000592 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000010 ;
                obo:IAO_0000114 obo:IAO_0000123 ;
                obo:IAO_0000117 "PERSON: Melanei Courtot"@en ,
                                "PERSON: Michel Dumontier"@en ;
                obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                rdfs:label "software module"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A software module is software composed of a collection of software methods."@en .


###  http://purl.obolibrary.org/obo/IAO_0000593
obo:IAO_0000593 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000010 ;
                obo:IAO_0000114 obo:IAO_0000123 ;
                obo:IAO_0000117 "PERSON: Melanie Courtot"@en ,
                                "PERSON: Michel Dumontier"@en ;
                obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                rdfs:label "software library"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en .


###  http://purl.obolibrary.org/obo/IAO_0000594
obo:IAO_0000594 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000010 ;
                obo:IAO_0000114 obo:IAO_0000123 ;
                obo:IAO_0000117 "PERSON: Melanie Courtot"@en ,
                                "PERSON: Michel Dumontier"@en ;
                obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
                rdfs:label "software application"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A software application is software that can be directly executed by some processing unit."@en .


###  http://purl.obolibrary.org/obo/IAO_0000595
obo:IAO_0000595 rdf:type owl:Class ;
