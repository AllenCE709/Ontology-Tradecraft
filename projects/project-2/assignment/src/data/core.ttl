                obo:IAO_0000117 "PRS"@en ;
                obo:IAO_0000119 "OBI_0500021"@en ,
                                "PRS"@en ;
                rdfs:label "rule"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A rule is an executable which guides, defines, restricts actions."@en .


###  http://purl.obolibrary.org/obo/IAO_0000057
obo:IAO_0000057 rdf:type owl:Class ;
