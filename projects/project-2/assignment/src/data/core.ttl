#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/APOLLO_SV_00000008
obo:APOLLO_SV_00000008 rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( obo:COB_0000035
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:OBI_0000299 ;
                                                                    owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                         owl:unionOf ( obo:IAO_0000010
                                                                                                       obo:IAO_0000096
                                                                                                     )
                                                                                       ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf obo:COB_0000035 ;
                       obo:IAO_0000117 "Mathias Brochhausen"@en ,
                                       "William R. Hogan"@en ;
                       obo:IAO_0000119 "http://en.wikipedia.org/wiki/Software_development" ;
                       obo:IAO_0000600 "A planned process resulting in a software product involving the creation of source code."@en ;
                       rdfs:label "software development"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A planned process that has specified output a software product and that involves the creation of source code."@en .


###  http://purl.obolibrary.org/obo/APOLLO_SV_00000032
obo:APOLLO_SV_00000032 rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( obo:IAO_0000027
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:OBI_0000312 ;
                                                                    owl:someValuesFrom obo:APOLLO_SV_00000033
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf obo:IAO_0000109 ;
                       obo:IAO_0000117 "Mathias Brochhausen" ;
                       obo:IAO_0000600 "A measurement datum that is the output of counting."@en ;
                       rdfs:label "count"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A measurement datum that is the output of counting."@en .


###  http://purl.obolibrary.org/obo/APOLLO_SV_00000033
obo:APOLLO_SV_00000033 rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( obo:COB_0000035
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:OBI_0000299 ;
                                                                    owl:someValuesFrom obo:APOLLO_SV_00000032
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf obo:COB_0000035 ;
                       obo:IAO_0000117 "Mathias Brochhausen" ;
                       obo:IAO_0000119 "http://en.wikipedia.org/wiki/Counting" ;
                       obo:IAO_0000600 "The planned process of finding the number of elements in a finite set of objects."@en ;
                       rdfs:label "counting"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "The planned process of finding the number of elements in a finite set of objects."@en .


###  http://purl.obolibrary.org/obo/APOLLO_SV_00000522
obo:APOLLO_SV_00000522 rdf:type owl:Class ;
                       rdfs:subClassOf obo:IAO_0000310 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000051 ;
                                         owl:someValuesFrom obo:IAO_0000096
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty obo:BFO_0000051 ;
                                         owl:someValuesFrom [ owl:intersectionOf ( obo:IAO_0000027
                                                                                   [ rdf:type owl:Restriction ;
                                                                                     owl:onProperty obo:IAO_0000136 ;
                                                                                     owl:someValuesFrom obo:IAO_0000096
                                                                                   ]
                                                                                 ) ;
                                                              rdf:type owl:Class
                                                            ]
                                       ] ;
                       obo:IAO_0000111 "software source code version control repository"@en ;
                       obo:IAO_0000117 "William R. Hogan"@en ;
                       rdfs:comment "Refers to the stuff that lives on GitHub, not to GitHub or the git software on which it is based"@en ;
                       rdfs:label "source code repository"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A document that comprises at least one source code module and provenance data about who contributed the set of files making up the module(s), and optionally comprises also multiple versions of files with detailed change history about who committed files and when, a license for the software, readme files, documentation, executables, etc."@en .


###  http://purl.obolibrary.org/obo/APOLLO_SV_00000524
obo:APOLLO_SV_00000524 rdf:type owl:Class ;
                       rdfs:subClassOf obo:COB_0000035 ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:OBI_0000293 ;
                                                                owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                     owl:unionOf ( obo:IAO_0000010
                                                                                                   obo:IAO_0000096
                                                                                                 )
                                                                                   ]
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty obo:OBI_0000299 ;
                                                                owl:someValuesFrom obo:IAO_0000010
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       obo:IAO_0000111 "process of compiling software"@en ;
                       obo:IAO_0000117 "William R. Hogan"@en ;
                       rdfs:comment "It's compiling \"software\" (scare quotes) and not \"source code\" because you can compile Java bytecode to machine code, and Java bytecode is not technically \"source code\".  Compiling source code would be a subclass of this class (as would compiling Java bytecode, etc.)."@en ,
                                    "Source code can be automatically generated to some extent, but we're assuming humans still curate it minimally. Also, in the case of Java and its JVM, it's machine interpretable instructions, not directly executable. Ditto for other languages with intermediate form like Java byte code."@en ;
                       rdfs:label "compiling software"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A planned process that converts human-written or curated software into a machine-executable or interpretable set of instructions."@en .


###  http://purl.obolibrary.org/obo/APOLLO_SV_00000796
obo:APOLLO_SV_00000796 rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( obo:COB_0000035
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty obo:OBI_0000299 ;
                                                                    owl:someValuesFrom obo:IAO_0000100
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ;
                       rdfs:subClassOf obo:COB_0000035 ;
                       obo:IAO_0000111 "creating a data set"@en ;
                       obo:IAO_0000117 "William R. Hogan"@en ;
                       obo:IAO_0000118 "data set creation"@en ,
                                       "dataset creation"@en ;
                       rdfs:label "dataset creating"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "A planned process that has a data set as its specified output."@en .


