                                      rdfs:label "has Two Wake Category Appx A" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Category A to category G based on aircraft wingspan and maximum takeoff weight" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Two_Wake_Category_Appx_B
iao-edit:has_Two_Wake_Category_Appx_B rdf:type owl:DatatypeProperty ;
                                      rdfs:domain iao-edit:Aircraft ;
                                      rdfs:range xsd:string ;
                                      rdfs:label "has Two Wake Category Appx B" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Category A to category G based on aircraft wingspan and maximum takeoff weight" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Wheelbase_Ft
iao-edit:has_Wheelbase_Ft rdf:type owl:DatatypeProperty ;
                          rdfs:domain iao-edit:Aircraft ;
                          rdfs:range xsd:decimal ;
                          rdfs:label "has Wheelbase Ft" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Wheelbase is the distance between main gears and nose gear/gears" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_Wingspan_With_Winglets_Ft
iao-edit:has_Wingspan_With_Winglets_Ft rdf:type owl:DatatypeProperty ;
                                       rdfs:domain iao-edit:Aircraft ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:label "has Wingspan With Winglets Ft" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> """Aircraft Wingspan applicable for those models with winglets or sharklets
Wingspan is measured from tip to tip.""" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_model_FAA
iao-edit:has_model_FAA rdf:type owl:DatatypeProperty ;
                       rdfs:domain iao-edit:Aircraft ;
                       rdfs:range xsd:string ;
